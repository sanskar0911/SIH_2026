# TC-INTEL INDIA Backend Environment Variables
APP_NAME="TC-INTEL INDIA — SIH 2026 PS26070"
DEBUG=true
ENVIRONMENT=development
API_V1_STR=/api/v1

# Database Configuration
# Defaults to local SQLite for instant zero-dependency execution if PostgreSQL is unavailable
DATABASE_URL=sqlite:///./tc_intel.db
# PostgreSQL PostGIS Example: postgresql://postgres:postgres@localhost:5432/tc_intel

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security / JWT
JWT_SECRET=super-secret-sih-2026-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / Simulation Modes
MOCK_DATA_MODE=true
GPU_ENABLED=false
MODEL_PATH=./models/checkpoints

# Satellite / External Data Credentials
MOSDAC_BASE_URL=https://mosdac.gov.in/api
MOSDAC_API_KEY=

OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=cyclone-imagery
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
